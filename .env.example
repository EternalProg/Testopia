NODE_ENV=development
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://testopia:testopia@localhost:3306/testopia
TEST_DATABASE_URL=mysql://testopia:testopia@localhost:3306/test_testopia
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-development-secret
